PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Secret used to sign the cookie-parser session cookie. Falls back to
# JWT_SECRET when COOKIE_SECRET is not set.
COOKIE_SECRET=replace-with-a-long-random-string
JWT_SECRET=your-jwt-signing-secret

DATABASE_URL=postgresql://user:password@vps-host:5432/employee_portal
DATABASE_TABLE=employees
